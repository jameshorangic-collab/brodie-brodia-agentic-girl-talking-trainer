LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>
# Canonical LiveKit dispatch name for the Brodia worker.
AGENT_NAME=brodia
GEMINI_API_KEY=<key>
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
# Brodia ignores GEMINI_VOICE/GEMINI_LANGUAGE. Native audio uses English system instructions.
BRODIA_GEMINI_VOICE=Leda
BRODIA_EVALUATOR_MODEL=gemini-3.5-flash-lite
BRODIA_RAPPORT_INITIAL='{"interested":65,"neutral":40,"uninterested":15}'
# Optional fallback only; Gemini is the default voice provider.
# OPENAI_API_KEY=<key>
